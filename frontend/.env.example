# ═══════════════════════════════════════════════════════════════════════════════
# CodeToday Frontend Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Backend API Base URL
VITE_API_URL=http://localhost:5000/api

# App Configuration
VITE_APP_NAME=CodeToday
VITE_APP_DOMAIN=localhost

# ─────────────────────────────────────────────────────────────────────────────
# Development
# ─────────────────────────────────────────────────────────────────────────────
# Default Vite dev server: http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# Production Deployment (uncomment and update for your platform)
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS (CloudFront + S3) ──
# VITE_API_URL=https://api.codetoday.com/api
# VITE_APP_DOMAIN=codetoday.com

# ── Vercel ──
# VITE_API_URL=https://api.codetoday.com/api
# VITE_APP_DOMAIN=app.codetoday.com

# ── Netlify ──
# VITE_API_URL=https://api.codetoday.com/api
# VITE_APP_DOMAIN=app.codetoday.com

# ── Self-hosted ──
# VITE_API_URL=https://your-domain.com/api
# VITE_APP_DOMAIN=your-domain.com
