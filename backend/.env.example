# ═══════════════════════════════════════════════════════════════════════════════
# CodeToday Backend Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Environment
NODE_ENV=development
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# JWT & Security Keys (CHANGE THESE IN PRODUCTION!)
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=editorcode-jwt-secret-key-minimum-32-chars-required!!
JWT_REFRESH_SECRET=editorcode-refresh-secret-minimum-32-chars-required!
CSRF_SECRET=csrf-secret-minimum-32-characters-long-required-here!

# ─────────────────────────────────────────────────────────────────────────────
# MongoDB Configuration
# ─────────────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/codetoday
MONGO_DB_NAME=codetoday
MONGO_TIMEOUT_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# Redis Configuration (optional - used for production multi-instance)
# Set CACHE_BACKEND=memory to use in-memory cache instead
# ─────────────────────────────────────────────────────────────────────────────
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# Frontend & CORS Configuration
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ─────────────────────────────────────────────────────────────────────────────
# Code Execution (Sandbox)
# ─────────────────────────────────────────────────────────────────────────────
PYTHON_EXECUTOR_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────────────────────
# Token Expiry Configuration (in seconds)
# ─────────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRES=1800
ACCESS_TOKEN_REMEMBER=2592000
REFRESH_TOKEN_EXPIRES=2592000
CSRF_TOKEN_EXPIRES=86400

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_CODE_EXECUTION_ATTEMPTS=20
RATE_LIMIT_CODE_EXECUTION_WINDOW_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# Deployment Targets (uncomment for your platform)
# ─────────────────────────────────────────────────────────────────────────────

# ── Local Development ──
# Use defaults above

# ── AWS (RDS + ElastiCache) ──
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/codetoday?retryWrites=true
# REDIS_URL=redis://your-elasticache-endpoint.ng.0001.use1.cache.amazonaws.com:6379

# ── Heroku ──
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/codetoday
# REDIS_URL=redis://your-redis-addon.herokuapp.com:12345

# ── GCP Cloud Run ──
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/codetoday
# REDIS_URL=redis://your-memorystore-endpoint:6379

# ─────────────────────────────────────────────────────────────────────────────
# Production Security (IMPORTANT!)
# ─────────────────────────────────────────────────────────────────────────────
# ALWAYS generate new secrets for production:
# python -c "import secrets; print(secrets.token_hex(32))"
#
# Set NODE_ENV=production
# Use HTTPS only (secure=True for cookies)
# Enable proper CORS origins
# Use strong MongoDB credentials
# Enable Redis persistence if using Redis
